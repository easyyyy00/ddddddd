# 4. 조건 필터링 알고리즘 및 예외 처리
# -----------------------------------------------------------------------------
def filter_artworks(data, movement, mood, max_time):
    """
    선택된 조건(사조, 분위기)에 맞는 작품을 필터링하고,
    시간 내에 들어가는 최선의 작품 조합을 도출합니다.
    """
    filtered = []
    
    for item in data:
        # 사조 필터링
        match_movement = (movement == "전체") or (item["movement"] == movement)
        # 분위기 필터링
        match_mood = (mood == "전체") or (item["mood"] == mood)
        
        if match_movement and match_mood:
            filtered.append(item)
            
    # 시간 조건에 맞춘 작품 선정 (누적 소요 시간이 제한 시간을 넘지 않도록 추출)
    selected_artworks = []
    current_time = 0
    
    for item in filtered:
        if current_time + item["duration"] <= max_time:
            selected_artworks.append(item)
            current_time += item["duration"]
            
    return selected_artworks

# 필터링 수행
recommended_list = filter_artworks(ARTWORKS_DATABASE, selected_movement, selected_mood, max_time)
is_fallback = False

# 예외 처리: 조건에 부합하는 작품이 없을 경우 대표 명화 자동 대처
if not recommended_list:
    is_fallback = True
    # 기본 대표 명화 3개 추출 (시간 조건에 맞게 제한)
    default_candidates = [ARTWORKS_DATABASE[0], ARTWORKS_DATABASE[1], ARTWORKS_DATABASE[5]]
    recommended_list = []
    accumulated = 0
    for item in default_candidates:
        if accumulated + item["duration"] <= max_time:
            recommended_list.append(item)
            accumulated += item["duration"]
            
    # 시간이 15분 등으로 매우 짧아서 아무것도 안 담길 경우 최우선 1개 강제 배정
